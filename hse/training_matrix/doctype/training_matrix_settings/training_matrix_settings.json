   "fieldname": "section_escalation",
   "fieldtype": "Section Break",
   "label": "Overdue Escalation (TRN-700 §4.9)",
   "description": "The employee's manager is notified the day a course goes overdue. If it is still overdue after this many days, it escalates to the people below."
  },
  {
   "fieldname": "escalation_days",
   "fieldtype": "Int",
   "label": "Escalate After (days overdue)",
   "default": "14",
   "non_negative": 1
  },
  {
   "fieldname": "escalation_roles",
   "fieldtype": "Table MultiSelect",
   "label": "Escalate To Roles",
   "options": "Training Matrix Settings Role",
