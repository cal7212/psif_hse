   "label": "Disabled",
   "default": "0"
  },
  {
   "fieldname": "all_employees",
   "fieldtype": "Check",
   "label": "All Employees",
   "default": "0",
   "in_standard_filter": 1,
   "description": "Required for every active employee, whatever their Training Role."
  },
  {
   "fieldname": "high_hazard",
   "fieldtype": "Check",
   "label": "High-Hazard Work",
   "default": "0",
   "in_standard_filter": 1,
   "description": "TRN-700 §4.4: authorizes high-hazard work and needs a practical evaluation."
  },
  {
   "fieldname": "requires_qualified_trainer",
   "fieldtype": "Check",
   "label": "Requires Qualified Trainer",
   "default": "0",
   "description": "Training and evaluation must be by a Qualified Trainer for this course."
  },
  {
   "fieldname": "section_delivery",
   "fieldtype": "Section Break",
   "label": "Delivery and Verification"
  },
  {
   "fieldname": "delivery_method",
   "fieldtype": "Data",
   "label": "Delivery Method",
   "description": "Classroom, e-Learning, Read & Acknowledge, OJT, Demonstration or External."
  },
  {
   "fieldname": "duration_minutes",
   "fieldtype": "Int",
   "label": "Duration (minutes)"
  },
  {
   "fieldname": "column_break_d",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "verification_method",
   "fieldtype": "Select",
   "label": "Competency Verification",
   "options": "\nQuiz (80%)\nLMS Acknowledgment\nLMS Attendance Record\nLMS Completion Record\nPractical Demonstration\nPractical Evaluation\nTest and Practical\nSupervisor Observation\nValid Certificate\nQuiz and MVR Review\nCertificate and Observed Audit\nTRN-704 Checklist"
  },
  {
   "fieldname": "section_frequency",
   "fieldtype": "Section Break",
   "label": "Due Date and Frequency"
  },
  {
   "fieldname": "initial_due_basis",
   "fieldtype": "Select",
   "label": "First Due From",
   "options": "Date of Hire\nDate Assigned",
   "default": "Date Assigned",
   "reqd": 1,
   "description": "Date Assigned = when the course is added to the employee's matrix (new role, transfer, promotion)."
  },
  {
   "fieldname": "initial_due_days",
   "fieldtype": "Int",
   "label": "Days Allowed",
   "default": "0",
   "description": "0 = before work / upon assignment. e.g. 30 for 'within 30 days of hire'."
  },
  {
   "fieldname": "column_break_f",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "refresher_frequency",
   "fieldtype": "Select",
   "label": "Refresher",
   "options": "One-time\nAnnually\nEvery 2 Years\nEvery 3 Years\nPer Certification",
   "default": "Annually",
   "reqd": 1,
   "description": "TRN-700 §4.4: safety training is annual unless OSHA sets a different interval."
  },
  {
   "fieldname": "retrain_on_revision",
