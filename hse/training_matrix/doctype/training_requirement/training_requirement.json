  {
   "fieldname": "course_title",
   "fieldtype": "Data",
   "label": "Training Topic",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "avenue",
   "fieldtype": "Select",
