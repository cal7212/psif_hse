   "options": "HR Onboarding\nSafety / EHS\nQMS\nTechnical",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "disabled",
