   "fieldtype": "Small Text",
   "label": "Safe Work Practices"
  },
  {
   "fieldname": "column_break_practices",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "acc_barricade",
   "fieldtype": "Check",
   "label": "Barricades / barrier tape at the limited approach or arc flash boundary"
