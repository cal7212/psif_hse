  {
   "fieldname": "work_description",
   "fieldtype": "Small Text",
   "label": "Work to Be Performed",
   "reqd": 1
  },
  {
   "description": "Greater Hazard: de-energizing would create a greater hazard (e.g. life-support, alarms, hazardous-location ventilation). Infeasibility: the task cannot be done de-energized (e.g. a continuous process that cannot be shut down).",
   "fieldname": "justification_type",
   "fieldtype": "Select",
   "label": "Justification",
   "options": "\nGreater Hazard\nInfeasibility"
  },
  {
   "fieldname": "column_break_work",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "justification",
   "fieldtype": "Small Text",
   "label": "Why the Work Must Be Done Energized"
  },
  {
   "fieldname": "esc_not_feasible",
   "fieldtype": "Check",
   "label": "An electrically safe work condition cannot be established for this work"
  },
  {
   "fieldname": "section_shock",
   "fieldtype": "Section Break",
   "label": "Shock Risk Assessment"
  },
  {
   "description": "e.g. 480 V AC, 3-phase",
   "fieldname": "nominal_voltage",
   "fieldtype": "Data",
   "label": "Voltage Exposure"
  },
  {
   "description": "e.g. 3 ft 6 in",
   "fieldname": "limited_approach",
   "fieldtype": "Data",
   "label": "Limited Approach Boundary"
  },
  {
   "description": "e.g. 1 ft 0 in",
   "fieldname": "restricted_approach",
   "fieldtype": "Data",
   "label": "Restricted Approach Boundary"
  },
  {
   "fieldname": "column_break_shock",
   "fieldtype": "Column Break"
  },
  {
   "description": "PPE and other protection, e.g. Class 0 rubber insulating gloves with leather protectors, insulated tools, insulating blankets",
   "fieldname": "shock_ppe",
   "fieldtype": "Small Text",
   "label": "Shock Protection"
  },
  {
   "fieldname": "section_arc",
   "fieldtype": "Section Break",
   "label": "Arc Flash Risk Assessment"
  },
  {
   "default": "Incident Energy Analysis",
   "fieldname": "arc_method",
   "fieldtype": "Select",
   "label": "Method",
   "options": "Incident Energy Analysis\nPPE Category Method"
  },
  {
   "depends_on": "eval:doc.arc_method=='Incident Energy Analysis'",
   "fieldname": "incident_energy",
   "fieldtype": "Float",
   "label": "Incident Energy (cal/cm²)",
   "precision": "1"
  },
  {
   "description": "e.g. 18 in",
   "fieldname": "working_distance",
   "fieldtype": "Data",
   "label": "Working Distance"
  },
  {
   "depends_on": "eval:doc.arc_method=='PPE Category Method'",
   "fieldname": "ppe_category",
   "fieldtype": "Select",
   "label": "Arc Flash PPE Category",
   "options": "\n1\n2\n3\n4"
  },
  {
   "fieldname": "column_break_arc",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "arc_flash_boundary",
   "fieldtype": "Data",
   "label": "Arc Flash Boundary"
  },
  {
   "description": "e.g. arc-rated shirt, pants and face shield with balaclava rated at least 8 cal/cm², hearing protection",
   "fieldname": "arc_flash_ppe",
   "fieldtype": "Small Text",
   "label": "Arc Flash PPE"
  },
  {
   "fieldname": "label_verified",
   "fieldtype": "Check",
   "label": "Equipment label checked against this assessment"
  },
  {
   "fieldname": "section_practices",
   "fieldtype": "Section Break",
   "label": "Safe Work Practices and Access"
  },
  {
