   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "no_copy": 1,
   "options": "Draft\nApproved\nClosed\nCancelled",
   "read_only": 1
  },
  {
   "fieldname": "work_start",
   "fieldtype": "Datetime",
   "in_list_view": 1,
   "label": "Work From",
   "reqd": 1
