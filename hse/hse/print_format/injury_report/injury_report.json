 "doc_type": "Injury_Illness Report",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": null,
 "font_size": 14,
 "format_data": null,
 "html": "<style>\n    .injury-report-format {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 11px;\n        color: #000;\n        width: 100%;\n    }\n\n    .injury-report-format .ir-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        border-bottom: 2px solid #000;\n        padding-bottom: 6px;\n        margin-bottom: 8px;\n    }\n\n    .injury-report-format .ir-title {\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .injury-report-format .ir-logo-block {\n        text-align: right;\n    }\n\n    .injury-report-format .ir-logo-block img {\n        max-height: 55px;\n        max-width: 220px;\n    }\n\n    .injury-report-format .ir-company-name {\n        font-weight: bold;\n        font-size: 13px;\n    }\n\n    .injury-report-format .ir-page-label {\n        font-size: 10px;\n        font-weight: bold;\n        margin-top: 4px;\n    }\n\n    .injury-report-format .ir-instructions {\n        font-size: 10.5px;\n        margin-bottom: 8px;\n        line-height: 1.4;\n    }\n\n    .injury-report-format .ir-return-box {\n        font-weight: bold;\n    }\n\n    .injury-report-format .ir-doc-line {\n        font-size: 10.5px;\n        margin: 6px 0 4px 0;\n    }\n\n    .injury-report-format .ir-checkbox-row {\n        display: flex;\n        gap: 22px;\n        font-size: 11px;\n        font-weight: bold;\n        margin-bottom: 10px;\n        flex-wrap: wrap;\n    }\n\n    .injury-report-format .ir-checkbox-row > span {\n        display: inline-block;\n        margin-right: 22px;\n        white-space: nowrap;\n    }\n\n    .injury-report-format .ir-checkbox-row span.box {\n        display: inline-block;\n        width: 12px;\n        height: 12px;\n        border: 1.5px solid #000;\n        text-align: center;\n        line-height: 11px;\n        font-size: 11px;\n        margin-right: 4px;\n        vertical-align: middle;\n    }\n\n    .injury-report-format table.ir-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 8px;\n    }\n\n    .injury-report-format table.ir-table td,\n    .injury-report-format table.ir-table th {\n        border: 1px solid #000;\n        padding: 5px 6px;\n        vertical-align: top;\n        font-size: 11px;\n    }\n\n    .injury-report-format table.ir-table th {\n        background: #d9d9d9;\n        text-transform: uppercase;\n        font-size: 9.5px;\n        font-weight: bold;\n        text-align: left;\n    }\n\n    .injury-report-format .ir-value {\n        min-height: 16px;\n    }\n\n    .injury-report-format .ir-section-label {\n        background: #d9d9d9;\n        border: 1px solid #000;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        padding: 5px 6px;\n    }\n\n    .injury-report-format .ir-section-body {\n        border: 1px solid #000;\n        border-top: none;\n        padding: 8px 6px;\n        min-height: 40px;\n        margin-bottom: 8px;\n        font-size: 11px;\n        white-space: pre-wrap;\n    }\n\n    .injury-report-format .ir-section-body.tall {\n        min-height: 70px;\n    }\n\n    .injury-report-format .ir-ack {\n        font-size: 10.5px;\n        margin: 14px 0 6px 0;\n        line-height: 1.5;\n    }\n\n    .injury-report-format table.ir-sig-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 0 0 22px 0;\n    }\n\n    .injury-report-format table.ir-sig-table td {\n        border: none;\n        padding: 0;\n    }\n\n    .injury-report-format table.ir-sig-table td.sig-val {\n        border-bottom: 1px solid #000;\n        vertical-align: bottom;\n        padding: 16px 4px 2px 4px;\n        font-size: 11px;\n    }\n\n    .injury-report-format table.ir-sig-table td.sig-gap {\n        width: 4%;\n    }\n\n    .injury-report-format table.ir-sig-table td.sig-label {\n        padding-top: 3px;\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-align: left;\n    }\n\n    .injury-report-format .ir-rev {\n        text-align: right;\n        font-size: 9px;\n        margin-top: -4px;\n        margin-bottom: 6px;\n    }\n\n    .injury-report-format .ir-days-table td { font-size: 10.5px; padding: 3px 5px; }\n\n    .injury-report-format .page-break {\n        page-break-before: always;\n    }\n</style>\n\n{% set employee_full_name = ((frappe.db.get_value(\"Employee\", doc.employee_name, \"employee_name\") if doc.employee_name else \"\") or doc.employee_name or \"\") %}\n{% set completed_by_name = ((frappe.db.get_value(\"Employee\", doc.completed_by, \"employee_name\") if doc.completed_by else \"\") or doc.completed_by or \"\") %}\n{% set manager_full_name = ((frappe.db.get_value(\"Employee\", doc.managers_name, \"employee_name\") if doc.managers_name else \"\") or doc.managers_name or \"\") %}\n{% set non_employee = ((doc.non_employee_name or \"\") | trim) %}\n{% set company_name = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or \"\" %}\n{% set company_logo = frappe.db.get_value(\"Company\", company_name, \"company_logo\") if company_name else None %}\n{% set report_date = doc.completed_by_date or doc.creation %}\n{% macro rich(value) -%}{{ (frappe.utils.strip_html(value) | replace(\"&nbsp;\", \" \") | trim) if value else \"\" }}{%- endmacro %}\n{% set persons_involved = ([employee_full_name, non_employee] | select | join(\", \")) %}\n\n<div class=\"injury-report-format\">\n\n    <!-- ===================== PAGE 1 ===================== -->\n    <div class=\"ir-header\">\n        <div>\n            <div class=\"ir-title\">Workplace Incident/Injury/Near Miss Report</div>\n        </div>\n        <div class=\"ir-logo-block\">\n            {% if company_logo %}\n                <img src=\"{{ company_logo }}\" alt=\"{{ company_name }}\">\n            {% else %}\n                <img src=\"data:image/png;base64,\" alt=\"Power Systems, Inc. of Florida\">\n            {% endif %}\n            <div class=\"ir-page-label\">Page 1 of 2</div>\n        </div>\n    </div>\n\n    <div class=\"ir-instructions\">\n        <b>Instructions:</b> Fill out this form as soon as possible to report a workplace incident with or\n        without injury (no matter how minor the injury), or a near miss incident.\n        &nbsp;<span class=\"ir-return-box\">Return this form to the HR Manager</span>\n    </div>\n\n    <div class=\"ir-doc-line\">\n        This form serves to <b>DOCUMENT</b> the following: <i>Select all that apply.</i>\n    </div>\n\n    <div class=\"ir-checkbox-row\">\n        <span><span class=\"box\">{{ \"X\" if doc.first_aid_only else \"\" }}</span> Injury (First Aid Only)</span>\n        <span><span class=\"box\">{{ \"X\" if doc.medical_treatment else \"\" }}</span> Injury (Medical Treatment Needed)</span>\n        <span><span class=\"box\">{{ \"X\" if doc.near_miss else \"\" }}</span> Near Miss</span>\n        <span><span class=\"box\">{{ \"X\" if doc.observation else \"\" }}</span> Observation</span>\n    </div>\n\n    <table class=\"ir-table\">\n        <tr>\n            <th style=\"width:34%\">Name of Person Completing Form</th>\n            <th style=\"width:33%\">Manager's Name</th>\n            <th style=\"width:33%\">Date of Report</th>\n        </tr>\n        <tr>\n            <td class=\"ir-value\">{{ completed_by_name }}</td>\n            <td class=\"ir-value\">{{ manager_full_name }}</td>\n            <td class=\"ir-value\">{{ frappe.utils.formatdate(report_date) if report_date else \"\" }}</td>\n        </tr>\n    </table>\n\n    <table class=\"ir-table\">\n        <tr>\n            <th style=\"width:50%\">Person(s) Involved</th>\n            <th style=\"width:50%\">Equipment/Vehicles Involved</th>\n        </tr>\n        <tr>\n            <td class=\"ir-value\">{{ persons_involved }}</td>\n            <td class=\"ir-value\">{{ doc.object_harm or \"\" }}</td>\n        </tr>\n    </table>\n\n    <table class=\"ir-table\">\n        <tr>\n            <th style=\"width:40%\">Location of Incident</th>\n            <th style=\"width:30%\">Date of Incident</th>\n            <th style=\"width:30%\">Time of Incident</th>\n        </tr>\n        <tr>\n            <td class=\"ir-value\">{{ doc.incident_location or \"\" }}</td>\n            <td class=\"ir-value\">{{ frappe.utils.formatdate(doc.incident_date) if doc.incident_date else \"\" }}</td>\n            <td class=\"ir-value\">{{ frappe.utils.format_time(doc.time_of_incident) if doc.get(\"time_of_incident\") else \"\" }}</td>\n        </tr>\n    </table>\n\n    <div class=\"ir-section-label\">Witnesses (if any)</div>\n    <div class=\"ir-section-body\">{{ doc.witnesses or \"\" }}</div>\n\n    <div class=\"ir-section-label\">Incident: Describe tasks being performed and sequence of events. Use back of this sheet if needed</div>\n    <div class=\"ir-section-body tall\">{{ rich(doc.short_description) }}{% if doc.what_happened %}\n\n{{ rich(doc.what_happened) }}{% endif %}</div>\n\n    <div class=\"ir-section-label\">If Near Miss, how could you or coworker have been hurt as a result of the near miss</div>\n    <div class=\"ir-section-body\">{{ doc.near_miss_description or \"N/A\" }}</div>\n\n    <div class=\"ir-section-label\">Was the event or injury caused by an unsafe act or condition (weather, lack of proper safety equip, etc.?)</div>\n    <div class=\"ir-section-body\">{{ doc.unsafe_act_description or \"\" }}</div>\n\n    <div class=\"ir-section-label\">If injured, what part of the body was affected (be specific and include left or right if applicable)</div>\n    <div class=\"ir-section-body\">{{ doc.body_part_affected or \"\" }}{% if doc.injury_type %}{{ \" - \" if doc.body_part_affected else \"\" }}{{ doc.injury_type }}{% endif %}{% if doc.injury_illness_desc %}\n{{ rich(doc.injury_illness_desc) }}{% endif %}</div>\n\n    <!-- ===================== PAGE 2 ===================== -->\n    <div class=\"page-break\"></div>\n\n    <div class=\"ir-rev\">Rev 4/2024</div>\n    <div class=\"ir-doc-line\" style=\"text-align:right; font-size:9.5px; margin-top:-8px;\">\n        {{ company_name }} \u2014 Workplace Incident/Injury/Near Miss Report \u2014 Page 2 of 2\n    </div>\n\n    <div class=\"ir-section-label\">If injured, was any time missed from work due to the injury? If so, how long?</div>\n    {% set away_total = (doc.days_away or []) | sum(attribute=\"number_of_days_away\") %}\n    {% set restricted_total = (doc.job_restriction or []) | sum(attribute=\"number_of_days_away\") %}\n    <div class=\"ir-section-body\" style=\"white-space: normal;\">\n        {% if not doc.days_away and not doc.job_restriction %}\n            No time missed recorded.\n        {% else %}\n            <table class=\"ir-table ir-days-table\" style=\"margin-bottom:0\">\n                <tr><th>Type</th><th>Start Date</th><th>Return Date</th><th style=\"text-align:right\">Days</th></tr>\n                {% for row in doc.days_away or [] %}\n                <tr><td>Days away from work</td><td>{{ frappe.utils.formatdate(row.start_date) if row.start_date else \"\" }}</td><td>{{ frappe.utils.formatdate(row.return_date) if row.return_date else \"Not yet returned\" }}</td><td style=\"text-align:right\">{{ row.number_of_days_away or 0 }}</td></tr>\n                {% endfor %}\n                {% for row in doc.job_restriction or [] %}\n                <tr><td>Job restriction/transfer</td><td>{{ frappe.utils.formatdate(row.start_date) if row.start_date else \"\" }}</td><td>{{ frappe.utils.formatdate(row.return_date) if row.return_date else \"Ongoing\" }}</td><td style=\"text-align:right\">{{ row.number_of_days_away or 0 }}</td></tr>\n                {% endfor %}\n            </table>\n            <div style=\"margin-top:4px\"><b>Total days away:</b> {{ away_total }} &nbsp;&nbsp; <b>Total restricted/transfer days:</b> {{ restricted_total }}</div>\n        {% endif %}\n    </div>\n\n    <div class=\"ir-section-label\">If medical treatment was needed, please give the name and location of hospital</div>\n    <div class=\"ir-section-body\">{{ doc.healthcare_facility or \"\" }}{% if doc.physician_name %}{{ \" - \" if doc.healthcare_facility else \"\" }}Physician: {{ doc.physician_name }}{% endif %}{% if doc.er or doc.overnight_hospitilization %}\n{{ \"Treated in emergency room\" if doc.er else \"\" }}{{ \"; \" if doc.er and doc.overnight_hospitilization else \"\" }}{{ \"Hospitalized overnight\" if doc.overnight_hospitilization else \"\" }}{% endif %}</div>\n\n    <div class=\"ir-ack\">\n        I acknowledge that the statements of this incident/injury are true and correct to the best of my ability.\n    </div>\n    <table class=\"ir-sig-table\">\n        <tr>\n            <td class=\"sig-val\" style=\"width:34%\">{{ employee_full_name }}</td>\n            <td class=\"sig-gap\"></td>\n            <td class=\"sig-val\" style=\"width:38%\"></td>\n            <td class=\"sig-gap\"></td>\n            <td class=\"sig-val\" style=\"width:20%\"></td>\n        </tr>\n        <tr>\n            <td class=\"sig-label\">Employee Name (Print)</td>\n            <td></td>\n            <td class=\"sig-label\">Employee Signature</td>\n            <td></td>\n            <td class=\"sig-label\">Date</td>\n        </tr>\n    </table>\n\n    <div class=\"ir-ack\">\n        I acknowledge and understand that if I refuse any medical treatment provided to me by my employer for the\n        injury I received, then I will be responsible for any treatment necessary.\n    </div>\n    <table class=\"ir-sig-table\">\n        <tr>\n            <td class=\"sig-val\" style=\"width:34%\">{{ employee_full_name }}</td>\n            <td class=\"sig-gap\"></td>\n            <td class=\"sig-val\" style=\"width:38%\"></td>\n            <td class=\"sig-gap\"></td>\n            <td class=\"sig-val\" style=\"width:20%\"></td>\n        </tr>\n        <tr>\n            <td class=\"sig-label\">Employee Name (Print)</td>\n            <td></td>\n            <td class=\"sig-label\">Employee Signature</td>\n            <td></td>\n            <td class=\"sig-label\">Date</td>\n        </tr>\n    </table>\n\n</div>\n",
 "line_breaks": 0,
