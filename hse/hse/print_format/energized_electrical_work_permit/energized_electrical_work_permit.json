 "format_data": null,
 "html": "<style>\n\n    .hse-form-format {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 11px;\n        color: #000;\n        width: 100%;\n    }\n\n    .hse-form-format .ir-header {\n        border-bottom: 2px solid #000;\n        padding-bottom: 6px;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format .ir-title {\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .hse-form-format .ir-doc-line {\n        font-size: 10.5px;\n        margin-top: 2px;\n    }\n\n    .hse-form-format table.ir-table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format table.ir-table td,\n    .hse-form-format table.ir-table th {\n        border: 1px solid #000;\n        padding: 5px 6px;\n        vertical-align: top;\n        font-size: 11px;\n        height: 14px;\n    }\n\n    .hse-form-format table.ir-table th {\n        background: #d9d9d9;\n        text-transform: uppercase;\n        font-size: 9.5px;\n        font-weight: bold;\n        text-align: left;\n    }\n\n    .hse-form-format .ir-section-label {\n        background: #d9d9d9;\n        border: 1px solid #000;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        padding: 5px 6px;\n    }\n\n    .hse-form-format .ir-section-body {\n        border: 1px solid #000;\n        border-top: none;\n        padding: 8px 6px;\n        min-height: 40px;\n        margin-bottom: 8px;\n        font-size: 11px;\n    }\n\n    .hse-form-format .ir-section-body.tall {\n        min-height: 70px;\n    }\n\n    .hse-form-format .ir-sub {\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        margin: 8px 0 2px 0;\n    }\n\n    .hse-form-format .ir-sub:first-child {\n        margin-top: 0;\n    }\n\n    .hse-form-format .ir-text {\n        white-space: pre-wrap;\n    }\n\n    .hse-form-format .ir-rich p {\n        margin: 0 0 4px 0;\n    }\n\n    .hse-form-format .ir-empty {\n        color: #555;\n    }\n\n    .hse-form-format ol.ir-causes {\n        margin: 0;\n        padding-left: 18px;\n    }\n\n    /* Kept on one page: moves to the next page whole rather than splitting. */\n    .hse-form-format .ir-keep {\n        display: block;\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n    .hse-form-format .ir-keep table,\n    .hse-form-format .ir-keep tr {\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n    .hse-form-format table.ir-actions {\n        border-top: none;\n    }\n\n    .hse-form-format table.ir-actions thead {\n        display: table-header-group;\n    }\n\n    .hse-form-format table.ir-actions thead th {\n        border-top: none;\n        font-size: 9px;\n    }\n\n    .hse-form-format table.ir-actions td {\n        font-size: 10.5px;\n    }\n\n    .hse-form-format .ca-title {\n        font-weight: bold;\n    }\n\n    .hse-form-format .ca-meta {\n        font-size: 9.5px;\n        color: #444;\n    }\n\n    .hse-form-format .ca-text {\n        margin-top: 3px;\n    }\n\n    .hse-form-format .ca-overdue {\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .hse-form-format table.ir-whys {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .hse-form-format table.ir-whys td {\n        border: 1px solid #000;\n        padding: 4px 6px;\n        vertical-align: top;\n        font-size: 11px;\n    }\n\n    .hse-form-format table.ir-whys td.why-n {\n        width: 13%;\n        background: #f0f0f0;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        white-space: nowrap;\n    }\n\n    .hse-form-format table.ir-sig-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 18px 0 10px 0;\n        page-break-inside: avoid;\n    }\n\n    .hse-form-format table.ir-sig-table td {\n        border: none;\n        padding: 0;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-val {\n        border-bottom: 1px solid #000;\n        vertical-align: bottom;\n        padding: 16px 4px 2px 4px;\n        font-size: 11px;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-img {\n        padding: 2px 4px 2px 4px;\n        height: 48px;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-gap {\n        width: 4%;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-label {\n        padding-top: 3px;\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-align: left;\n    }\n\n    .hse-form-format .ir-post {\n        border: 2px solid #000;\n        text-align: center;\n        font-weight: bold;\n        font-size: 10px;\n        text-transform: uppercase;\n        padding: 4px;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format .cb {\n        display: inline-block;\n        width: 10px;\n        height: 10px;\n        line-height: 10px;\n        border: 1px solid #000;\n        text-align: center;\n        font-size: 9px;\n        font-weight: bold;\n        margin-right: 4px;\n        vertical-align: middle;\n    }\n\n    .hse-form-format table.ir-checks {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    .hse-form-format table.ir-checks td {\n        border: none;\n        padding: 2px 4px;\n        font-size: 10.5px;\n        vertical-align: top;\n    }\n\n    .hse-form-format table.ir-table.ir-grid td,\n    .hse-form-format table.ir-table.ir-grid th {\n        font-size: 10px;\n        padding: 4px 4px;\n    }\n\n    .hse-form-format table.ir-grid thead {\n        display: table-header-group;\n    }\n\n    .hse-form-format table.ir-grid tr {\n        page-break-inside: avoid;\n    }\n\n    .hse-form-format .ir-rate {\n        display: inline-block;\n        padding: 1px 4px;\n        font-weight: bold;\n        font-size: 9.5px;\n        border: 1px solid #000;\n    }\n\n    .hse-form-format table.ir-matrix {\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .hse-form-format table.ir-matrix td,\n    .hse-form-format table.ir-matrix th {\n        border: 1px solid #000;\n        padding: 2px 6px;\n        font-size: 9px;\n        text-align: center;\n    }\n\n    .hse-form-format .ir-small {\n        font-size: 9px;\n        color: #333;\n    }\n</style>\n\n{% macro fdate(value) -%}{{ frappe.utils.formatdate(value) if value else \"\" }}{%- endmacro %}\n{% macro fdt(value) -%}{{ frappe.utils.format_datetime(value) if value else \"\" }}{%- endmacro %}\n{% macro txt(value) -%}{{ (value or \"\") | e }}{%- endmacro %}\n{% macro cb(value, label) -%}<span class=\"cb\">{{ \"X\" if value else \"\" }}</span>{{ label }}{%- endmacro %}\n{% set RATE_BG = {\"Low\": \"#d9f2d9\", \"Medium\": \"#fff3c4\", \"High\": \"#ffd8b0\", \"Critical\": \"#f8c4c4\"} %}\n{% macro rate(score, rating) -%}{% if rating %}<span class=\"ir-rate\" style=\"background:{{ RATE_BG.get(rating, '#fff') }}\">{{ score }} {{ rating }}</span>{% endif %}{%- endmacro %}\n{% macro level(value) -%}{{ (value or \"\").split(\" \")[0] }}{%- endmacro %}\n{% macro sig(labels) -%}\n<table class=\"ir-sig-table\"><tr>\n{% for l in labels %}{% if not loop.first %}<td class=\"sig-gap\"></td>{% endif %}<td class=\"sig-val\">{{ l[1] or \"\" }}</td>{% endfor %}\n</tr><tr>\n{% for l in labels %}{% if not loop.first %}<td class=\"sig-gap\"></td>{% endif %}<td class=\"sig-label\">{{ l[0] }}</td>{% endfor %}\n</tr></table>\n{%- endmacro %}\n{% macro matrix() -%}\n<table class=\"ir-matrix\">\n<tr><th>L \\ S</th>{% for s in range(1, 6) %}<th>{{ s }}</th>{% endfor %}</tr>\n{% for l in range(5, 0, -1) %}<tr><th>{{ l }}</th>{% for s in range(1, 6) %}{% set r = s * l %}{% set band = \"Critical\" if r >= 20 else (\"High\" if r >= 10 else (\"Medium\" if r >= 5 else \"Low\")) %}<td style=\"background:{{ RATE_BG[band] }}\">{{ r }}</td>{% endfor %}</tr>{% endfor %}\n</table>\n<div class=\"ir-small\">Severity 1 Negligible, 2 Minor, 3 Moderate, 4 Major, 5 Catastrophic. Likelihood 1 Rare, 2 Unlikely, 3 Possible, 4 Likely, 5 Almost Certain.\nRisk = S &times; L: Low 1&ndash;4, Medium 5&ndash;9, High 10&ndash;16, Critical 20&ndash;25 (work must not proceed).</div>\n{%- endmacro %}\n\n<div class=\"hse-form-format\">\n<table class=\"psif-hdr\" style=\"width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 6px 0; border:none\">\n\t<tr>\n\t\t<td style=\"width:28%; font-size:9px; text-align:left; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">355 Gus Hipp Blvd.<br>Rockledge, FL 32955</td>\n\t\t<td style=\"width:44%; text-align:center; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\"><img src=\"{{ frappe.utils.get_url('/assets/hse/images/psif_logo.jpg') }}\" alt=\"Power Systems, Inc. of Florida\" style=\"height:52px\"></td>\n\t\t<td style=\"width:28%; font-size:9px; text-align:right; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">Tel: (321) 636-0085<br><b>www.psifla.com</b></td>\n\t</tr>\n</table>\n\n    <div class=\"ir-header\">\n        <div class=\"ir-title\">Energized Electrical Work Permit</div>\n        <div class=\"ir-doc-line\">Permit No. {{ doc.name }} &nbsp;|&nbsp; {{ doc.status }} &nbsp;|&nbsp; NFPA 70E 130.2(B)</div>\n    </div>\n    <div class=\"ir-section-label\">Part I &mdash; Requester</div>\n    <table class=\"ir-table\" style=\"border-top:none\">\n        <tr>\n            <th colspan=\"2\">Circuit / Equipment and Location</th>\n            <th>Location</th>\n            <th>Equipment</th>\n        </tr>\n        <tr>\n            <td colspan=\"2\" class=\"ir-text\">{{ txt(doc.equipment_description) }}</td>\n            <td>{{ doc.location or \"\" }}</td>\n            <td>{{ doc.asset or \"\" }}</td>\n        </tr>\n        <tr><th colspan=\"4\">Work to Be Performed</th></tr>\n        <tr><td colspan=\"4\" class=\"ir-text\">{{ txt(doc.work_description) }}</td></tr>\n        <tr>\n            <th style=\"width:25%\">Justification</th>\n            <th colspan=\"3\">Why the Work Must Be Done Energized</th>\n        </tr>\n        <tr>\n            <td>{{ doc.justification_type or \"\" }}</td>\n            <td colspan=\"3\" class=\"ir-text\">{{ txt(doc.justification) }}</td>\n        </tr>\n        <tr>\n            <th style=\"width:25%\">Work From</th>\n            <th style=\"width:25%\">Work Until</th>\n            <th style=\"width:25%\">Requested By</th>\n            <th style=\"width:25%\">Job Hazard Analysis</th>\n        </tr>\n        <tr>\n            <td>{{ fdt(doc.work_start) }}</td>\n            <td>{{ fdt(doc.work_end) }}</td>\n            <td>{{ doc.requested_by_name or doc.requested_by or \"\" }}</td>\n            <td>{{ doc.job_hazard_analysis or \"\" }}</td>\n        </tr>\n    </table>\n    {{ sig([[\"Requester\", doc.requested_by_name], [\"Date\", fdate(doc.creation)]]) }}\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Part II &mdash; Electrically Qualified Persons</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        {{ cb(doc.esc_not_feasible, \"An electrically safe work condition cannot be established for this work.\") }}\n    </div>\n\n    <table class=\"ir-table\">\n        <tr><th colspan=\"4\">Shock Risk Assessment</th></tr>\n        <tr>\n            <th style=\"width:25%\">Voltage Exposure</th>\n            <th style=\"width:25%\">Limited Approach Boundary</th>\n            <th style=\"width:25%\">Restricted Approach Boundary</th>\n            <th style=\"width:25%\">Shock Protection</th>\n        </tr>\n        <tr>\n            <td>{{ txt(doc.nominal_voltage) }}</td>\n            <td>{{ txt(doc.limited_approach) }}</td>\n            <td>{{ txt(doc.restricted_approach) }}</td>\n            <td class=\"ir-text\">{{ txt(doc.shock_ppe) }}</td>\n        </tr>\n        <tr><th colspan=\"4\">Arc Flash Risk Assessment &mdash; {{ doc.arc_method or \"\" }}</th></tr>\n        <tr>\n            <th>{% if doc.arc_method == \"PPE Category Method\" %}Arc Flash PPE Category{% else %}Incident Energy{% endif %}</th>\n            <th>Working Distance</th>\n            <th>Arc Flash Boundary</th>\n            <th>Arc Flash PPE</th>\n        </tr>\n        <tr>\n            <td>{% if doc.arc_method == \"PPE Category Method\" %}{{ doc.ppe_category or \"\" }}{% elif doc.incident_energy %}{{ doc.incident_energy }} cal/cm&sup2;{% endif %}</td>\n            <td>{{ txt(doc.working_distance) }}</td>\n            <td>{{ txt(doc.arc_flash_boundary) }}</td>\n            <td class=\"ir-text\">{{ txt(doc.arc_flash_ppe) }}</td>\n        </tr>\n        <tr><td colspan=\"4\">{{ cb(doc.label_verified, \"Equipment label checked against this assessment\") }}</td></tr>\n    </table>\n    </div>\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Safe Work Practices</div>\n    <div class=\"ir-section-body ir-text\">{{ txt(doc.safe_work_practices) }}</div>\n\n    <div class=\"ir-section-label\">Means of Restricting Access by Unqualified Persons</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        <table class=\"ir-checks\">\n            <tr>\n                <td>{{ cb(doc.acc_barricade, \"Barricades / barrier tape\") }}</td>\n                <td>{{ cb(doc.acc_signs, \"Danger signs posted\") }}</td>\n                <td>{{ cb(doc.acc_attendant, \"Attendant posted\") }}</td>\n            </tr>\n        </table>\n        {% if doc.access_other %}<div class=\"ir-text\">{{ txt(doc.access_other) }}</div>{% endif %}\n    </div>\n\n    <div class=\"ir-section-label\">Job Briefing</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        {{ cb(doc.briefing_done, \"Job briefing held, covering the job-specific hazards\") }}{% if doc.briefing_time %} &mdash; {{ fdt(doc.briefing_time) }}{% endif %}\n        {% if doc.briefing_notes %}<div class=\"ir-text\" style=\"margin-top:4px\">{{ txt(doc.briefing_notes) }}</div>{% endif %}\n    </div>\n    </div>\n\n    <div class=\"ir-keep\">\n    <table class=\"ir-table ir-grid\">\n        <thead>\n            <tr>\n                <th style=\"width:28%\">Name</th>\n                <th style=\"width:18%\">Role</th>\n                <th style=\"width:18%\">Company</th>\n                <th style=\"width:24%\">Signature (briefed)</th>\n                <th style=\"width:12%\">Date</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for w in doc.workers %}\n            <tr><td>{{ w.worker_name or \"\" }}</td><td>{{ w.role or \"\" }}</td><td>{{ w.employer or \"\" }}</td><td style=\"height:20px\"></td><td></td></tr>\n        {% endfor %}\n        {% for i in range(doc.workers | length, 4) %}\n            <tr><td style=\"height:20px\"></td><td></td><td></td><td></td><td></td></tr>\n        {% endfor %}\n        </tbody>\n    </table>\n    </div>\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Part III &mdash; Approval to Perform Work While Energized</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        {{ sig([[\"Approved By (Management / Safety)\", doc.approved_by_name or doc.approved_by], [\"Date / Time\", fdt(doc.approved_on)]]) }}\n    </div>\n\n    <div class=\"ir-section-label\">Permit Closure</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        {{ cb(doc.closure_reason == \"Work Completed\", \"Work completed\") }} &nbsp;\n        {{ cb(doc.closure_reason == \"Prohibited Condition\", \"Stopped: unsafe condition\") }} &nbsp;\n        {{ cb(doc.closure_reason == \"Permit Expired\", \"Authorized period ended\") }}\n        {% if doc.closure_notes %}<div class=\"ir-text\" style=\"margin-top:4px\">{{ txt(doc.closure_notes) }}</div>{% endif %}\n        {{ sig([[\"Closed By\", doc.closed_by], [\"Date / Time\", fdt(doc.closed_on)]]) }}\n    </div>\n    </div>\n\n</div>\n",
