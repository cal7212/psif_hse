 "format_data": null,
 "html": "<style>\n\n    .hse-form-format {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 11px;\n        color: #000;\n        width: 100%;\n    }\n\n    .hse-form-format .ir-header {\n        border-bottom: 2px solid #000;\n        padding-bottom: 6px;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format .ir-title {\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .hse-form-format .ir-doc-line {\n        font-size: 10.5px;\n        margin-top: 2px;\n    }\n\n    .hse-form-format table.ir-table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format table.ir-table td,\n    .hse-form-format table.ir-table th {\n        border: 1px solid #000;\n        padding: 5px 6px;\n        vertical-align: top;\n        font-size: 11px;\n        height: 14px;\n    }\n\n    .hse-form-format table.ir-table th {\n        background: #d9d9d9;\n        text-transform: uppercase;\n        font-size: 9.5px;\n        font-weight: bold;\n        text-align: left;\n    }\n\n    .hse-form-format .ir-section-label {\n        background: #d9d9d9;\n        border: 1px solid #000;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        padding: 5px 6px;\n    }\n\n    .hse-form-format .ir-section-body {\n        border: 1px solid #000;\n        border-top: none;\n        padding: 8px 6px;\n        min-height: 40px;\n        margin-bottom: 8px;\n        font-size: 11px;\n    }\n\n    .hse-form-format .ir-section-body.tall {\n        min-height: 70px;\n    }\n\n    .hse-form-format .ir-sub {\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        margin: 8px 0 2px 0;\n    }\n\n    .hse-form-format .ir-sub:first-child {\n        margin-top: 0;\n    }\n\n    .hse-form-format .ir-text {\n        white-space: pre-wrap;\n    }\n\n    .hse-form-format .ir-rich p {\n        margin: 0 0 4px 0;\n    }\n\n    .hse-form-format .ir-empty {\n        color: #555;\n    }\n\n    .hse-form-format ol.ir-causes {\n        margin: 0;\n        padding-left: 18px;\n    }\n\n    /* Kept on one page: moves to the next page whole rather than splitting. */\n    .hse-form-format .ir-keep {\n        display: block;\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n    .hse-form-format .ir-keep table,\n    .hse-form-format .ir-keep tr {\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n    .hse-form-format table.ir-actions {\n        border-top: none;\n    }\n\n    .hse-form-format table.ir-actions thead {\n        display: table-header-group;\n    }\n\n    .hse-form-format table.ir-actions thead th {\n        border-top: none;\n        font-size: 9px;\n    }\n\n    .hse-form-format table.ir-actions td {\n        font-size: 10.5px;\n    }\n\n    .hse-form-format .ca-title {\n        font-weight: bold;\n    }\n\n    .hse-form-format .ca-meta {\n        font-size: 9.5px;\n        color: #444;\n    }\n\n    .hse-form-format .ca-text {\n        margin-top: 3px;\n    }\n\n    .hse-form-format .ca-overdue {\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .hse-form-format table.ir-whys {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .hse-form-format table.ir-whys td {\n        border: 1px solid #000;\n        padding: 4px 6px;\n        vertical-align: top;\n        font-size: 11px;\n    }\n\n    .hse-form-format table.ir-whys td.why-n {\n        width: 13%;\n        background: #f0f0f0;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        white-space: nowrap;\n    }\n\n    .hse-form-format table.ir-sig-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 18px 0 10px 0;\n        page-break-inside: avoid;\n    }\n\n    .hse-form-format table.ir-sig-table td {\n        border: none;\n        padding: 0;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-val {\n        border-bottom: 1px solid #000;\n        vertical-align: bottom;\n        padding: 16px 4px 2px 4px;\n        font-size: 11px;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-img {\n        padding: 2px 4px 2px 4px;\n        height: 48px;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-gap {\n        width: 4%;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-label {\n        padding-top: 3px;\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-align: left;\n    }\n\n    .hse-form-format .ir-post {\n        border: 2px solid #000;\n        text-align: center;\n        font-weight: bold;\n        font-size: 10px;\n        text-transform: uppercase;\n        padding: 4px;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format .cb {\n        display: inline-block;\n        width: 10px;\n        height: 10px;\n        line-height: 10px;\n        border: 1px solid #000;\n        text-align: center;\n        font-size: 9px;\n        font-weight: bold;\n        margin-right: 4px;\n        vertical-align: middle;\n    }\n\n    .hse-form-format table.ir-checks {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    .hse-form-format table.ir-checks td {\n        border: none;\n        padding: 2px 4px;\n        font-size: 10.5px;\n        vertical-align: top;\n    }\n\n    .hse-form-format table.ir-table.ir-grid td,\n    .hse-form-format table.ir-table.ir-grid th {\n        font-size: 10px;\n        padding: 4px 4px;\n    }\n\n    .hse-form-format table.ir-grid thead {\n        display: table-header-group;\n    }\n\n    .hse-form-format table.ir-grid tr {\n        page-break-inside: avoid;\n    }\n\n    .hse-form-format .ir-rate {\n        display: inline-block;\n        padding: 1px 4px;\n        font-weight: bold;\n        font-size: 9.5px;\n        border: 1px solid #000;\n    }\n\n    .hse-form-format table.ir-matrix {\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .hse-form-format table.ir-matrix td,\n    .hse-form-format table.ir-matrix th {\n        border: 1px solid #000;\n        padding: 2px 6px;\n        font-size: 9px;\n        text-align: center;\n    }\n\n    .hse-form-format .ir-small {\n        font-size: 9px;\n        color: #333;\n    }\n</style>\n\n{% macro fdate(value) -%}{{ frappe.utils.formatdate(value) if value else \"\" }}{%- endmacro %}\n{% macro fdt(value) -%}{{ frappe.utils.format_datetime(value) if value else \"\" }}{%- endmacro %}\n{% macro txt(value) -%}{{ (value or \"\") | e }}{%- endmacro %}\n{% macro cb(value, label) -%}<span class=\"cb\">{{ \"X\" if value else \"\" }}</span>{{ label }}{%- endmacro %}\n{% set RATE_BG = {\"Low\": \"#d9f2d9\", \"Medium\": \"#fff3c4\", \"High\": \"#ffd8b0\", \"Critical\": \"#f8c4c4\"} %}\n{% macro rate(score, rating) -%}{% if rating %}<span class=\"ir-rate\" style=\"background:{{ RATE_BG.get(rating, '#fff') }}\">{{ score }} {{ rating }}</span>{% endif %}{%- endmacro %}\n{% macro level(value) -%}{{ (value or \"\").split(\" \")[0] }}{%- endmacro %}\n{% macro sig(labels) -%}\n<table class=\"ir-sig-table\"><tr>\n{% for l in labels %}{% if not loop.first %}<td class=\"sig-gap\"></td>{% endif %}<td class=\"sig-val\">{{ l[1] or \"\" }}</td>{% endfor %}\n</tr><tr>\n{% for l in labels %}{% if not loop.first %}<td class=\"sig-gap\"></td>{% endif %}<td class=\"sig-label\">{{ l[0] }}</td>{% endfor %}\n</tr></table>\n{%- endmacro %}\n{% macro matrix() -%}\n<table class=\"ir-matrix\">\n<tr><th>L \\ S</th>{% for s in range(1, 6) %}<th>{{ s }}</th>{% endfor %}</tr>\n{% for l in range(5, 0, -1) %}<tr><th>{{ l }}</th>{% for s in range(1, 6) %}{% set r = s * l %}{% set band = \"Critical\" if r >= 20 else (\"High\" if r >= 10 else (\"Medium\" if r >= 5 else \"Low\")) %}<td style=\"background:{{ RATE_BG[band] }}\">{{ r }}</td>{% endfor %}</tr>{% endfor %}\n</table>\n<div class=\"ir-small\">Severity 1 Negligible, 2 Minor, 3 Moderate, 4 Major, 5 Catastrophic. Likelihood 1 Rare, 2 Unlikely, 3 Possible, 4 Likely, 5 Almost Certain.\nRisk = S &times; L: Low 1&ndash;4, Medium 5&ndash;9, High 10&ndash;16, Critical 20&ndash;25 (work must not proceed).</div>\n{%- endmacro %}\n\n<div class=\"hse-form-format\">\n<table class=\"psif-hdr\" style=\"width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 6px 0; border:none\">\n\t<tr>\n\t\t<td style=\"width:28%; font-size:9px; text-align:left; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">355 Gus Hipp Blvd.<br>Rockledge, FL 32955</td>\n\t\t<td style=\"width:44%; text-align:center; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\"><img src=\"{{ frappe.utils.get_url('/assets/hse/images/psif_logo.jpg') }}\" alt=\"Power Systems, Inc. of Florida\" style=\"height:52px\"></td>\n\t\t<td style=\"width:28%; font-size:9px; text-align:right; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">Tel: (321) 636-0085<br><b>www.psifla.com</b></td>\n\t</tr>\n</table>\n\n    <div class=\"ir-header\">\n        <div class=\"ir-title\">Risk Assessment</div>\n        <div class=\"ir-doc-line\">No. {{ doc.name }} &nbsp;|&nbsp; Revision {{ doc.revision or 1 }} &nbsp;|&nbsp; {{ doc.status }}</div>\n    </div>\n    <table class=\"ir-table\">\n        <tr>\n            <th colspan=\"2\">Activity / Area Assessed</th>\n            <th>Assessment Type</th>\n            <th>Reason</th>\n        </tr>\n        <tr>\n            <td colspan=\"2\"><b>{{ txt(doc.title) }}</b></td>\n            <td>{{ doc.assessment_type or \"\" }}</td>\n            <td>{{ doc.review_trigger or \"\" }}{% if doc.injury_report %} ({{ doc.injury_report }}){% endif %}</td>\n        </tr>\n        <tr>\n            <th style=\"width:25%\">Location</th>\n            <th style=\"width:25%\">Department</th>\n            <th style=\"width:25%\">Equipment</th>\n            <th style=\"width:25%\">Company</th>\n        </tr>\n        <tr>\n            <td>{{ doc.location or \"\" }}</td>\n            <td>{{ doc.department or \"\" }}</td>\n            <td>{{ doc.asset or \"\" }}</td>\n            <td>{{ doc.company or \"\" }}</td>\n        </tr>\n        <tr>\n            <th>Assessment Date</th>\n            <th>Lead Assessor</th>\n            <th>Next Review Due</th>\n            <th>Highest Residual Risk</th>\n        </tr>\n        <tr>\n            <td>{{ fdate(doc.assessment_date) }}</td>\n            <td>{{ doc.assessed_by_name or doc.assessed_by or \"\" }}</td>\n            <td>{{ fdate(doc.next_review_date) }}</td>\n            <td>{{ rate(doc.highest_residual_score, doc.highest_residual_rating) }}</td>\n        </tr>\n    </table>\n\n    <div class=\"ir-section-label\">Scope</div>\n    <div class=\"ir-section-body\">\n        <div class=\"ir-sub\">Description of Work</div>\n        <div class=\"ir-text\">{{ txt(doc.activity_description) or \"&nbsp;\" }}</div>\n        <div class=\"ir-sub\">Who Might Be Harmed</div>\n        <div class=\"ir-text\">{{ txt(doc.persons_at_risk) or \"&nbsp;\" }}</div>\n        {% if doc.team %}\n        <div class=\"ir-sub\">Assessment Team</div>\n        <div>{% for m in doc.team %}{{ m.employee_name or m.employee }}{% if m.team_role %} ({{ m.team_role }}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</div>\n        {% endif %}\n    </div>\n\n    <div class=\"ir-section-label\">Hazards and Controls</div>\n    <table class=\"ir-table ir-grid\" style=\"border-top:none\">\n        <thead>\n            <tr>\n                <th style=\"width:4%\">#</th>\n                <th style=\"width:20%\">Hazard</th>\n                <th style=\"width:14%\">Potential Harm</th>\n                <th style=\"width:17%\">Existing Controls</th>\n                <th style=\"width:10%\">Initial S / L / Risk</th>\n                <th style=\"width:24%\">Additional Controls</th>\n                <th style=\"width:11%\">Residual S / L / Risk</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for h in doc.hazards %}\n            <tr>\n                <td>{{ h.idx }}</td>\n                <td>{% if h.hazard_category %}<b>{{ h.hazard_category }}</b><br>{% endif %}<span class=\"ir-text\">{{ txt(h.hazard) }}</span></td>\n                <td class=\"ir-text\">{{ txt(h.consequence) }}</td>\n                <td class=\"ir-text\">{{ txt(h.existing_controls) }}</td>\n                <td>{{ level(h.initial_severity) }} / {{ level(h.initial_likelihood) }}<br>{{ rate(h.initial_score, h.initial_rating) }}</td>\n                <td>{% if h.control_type %}<b>{{ h.control_type }}</b><br>{% endif %}<span class=\"ir-text\">{{ txt(h.additional_controls) }}</span></td>\n                <td>{{ level(h.residual_severity) }} / {{ level(h.residual_likelihood) }}<br>{{ rate(h.residual_score, h.residual_rating) }}</td>\n            </tr>\n        {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"ir-keep\">\n        {{ matrix() }}\n    </div>\n\n    {% if doc.actions %}\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Actions</div>\n    <table class=\"ir-table ir-grid\" style=\"border-top:none\">\n        <thead>\n            <tr>\n                <th style=\"width:8%\">Hazard</th>\n                <th style=\"width:36%\">Action</th>\n                <th style=\"width:16%\">Control Type</th>\n                <th style=\"width:16%\">Responsible</th>\n                <th style=\"width:12%\">Due</th>\n                <th style=\"width:12%\">Completed</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for a in doc.actions %}\n            <tr>\n                <td>{{ a.hazard_no or \"All\" }}</td>\n                <td>{{ txt(a.title) }}{% if a.notes %}<div class=\"ir-small ir-text\">{{ txt(a.notes) }}</div>{% endif %}</td>\n                <td>{{ a.control_type or \"\" }}</td>\n                <td>{{ a.responsible_party or a.assigned_to or \"\" }}</td>\n                <td>{{ fdate(a.date_due) }}</td>\n                <td>{{ fdate(a.date_done) }}</td>\n            </tr>\n        {% endfor %}\n        </tbody>\n    </table>\n    </div>\n    {% endif %}\n\n    {% if doc.residual_risk_acceptance %}\n    <div class=\"ir-section-label\">High Residual Risk Acceptance</div>\n    <div class=\"ir-section-body ir-text\">{{ txt(doc.residual_risk_acceptance) }}</div>\n    {% endif %}\n\n    {% if doc.superseded_by %}\n    <div class=\"ir-post\">Superseded by {{ doc.superseded_by }}. Do not work to this revision.</div>\n    {% endif %}\n\n    {{ sig([[\"Lead Assessor\", doc.assessed_by_name], [\"Date\", fdate(doc.assessment_date)], [\"Approved By\", doc.approved_by_name or doc.approved_by], [\"Date\", fdate(doc.approved_on)]]) }}\n\n</div>\n",
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
