 "doctype": "Print Format",
 "font": null,
 "font_size": 14,
 "format_data": null,
 "html": "<style>\n\n    .hse-form-format {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 11px;\n        color: #000;\n        width: 100%;\n    }\n\n    .hse-form-format .ir-header {\n        border-bottom: 2px solid #000;\n        padding-bottom: 6px;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format .ir-title {\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .hse-form-format .ir-doc-line {\n        font-size: 10.5px;\n        margin-top: 2px;\n    }\n\n    .hse-form-format table.ir-table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format table.ir-table td,\n    .hse-form-format table.ir-table th {\n        border: 1px solid #000;\n        padding: 5px 6px;\n        vertical-align: top;\n        font-size: 11px;\n        height: 14px;\n    }\n\n    .hse-form-format table.ir-table th {\n        background: #d9d9d9;\n        text-transform: uppercase;\n        font-size: 9.5px;\n        font-weight: bold;\n        text-align: left;\n    }\n\n    .hse-form-format .ir-section-label {\n        background: #d9d9d9;\n        border: 1px solid #000;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        padding: 5px 6px;\n    }\n\n    .hse-form-format .ir-section-body {\n        border: 1px solid #000;\n        border-top: none;\n        padding: 8px 6px;\n        min-height: 40px;\n        margin-bottom: 8px;\n        font-size: 11px;\n    }\n\n    .hse-form-format .ir-section-body.tall {\n        min-height: 70px;\n    }\n\n    .hse-form-format .ir-sub {\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        margin: 8px 0 2px 0;\n    }\n\n    .hse-form-format .ir-sub:first-child {\n        margin-top: 0;\n    }\n\n    .hse-form-format .ir-text {\n        white-space: pre-wrap;\n    }\n\n    .hse-form-format .ir-rich p {\n        margin: 0 0 4px 0;\n    }\n\n    .hse-form-format .ir-empty {\n        color: #555;\n    }\n\n    .hse-form-format ol.ir-causes {\n        margin: 0;\n        padding-left: 18px;\n    }\n\n    /* Kept on one page: moves to the next page whole rather than splitting. */\n    .hse-form-format .ir-keep {\n        display: block;\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n    .hse-form-format .ir-keep table,\n    .hse-form-format .ir-keep tr {\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n    .hse-form-format table.ir-actions {\n        border-top: none;\n    }\n\n    .hse-form-format table.ir-actions thead {\n        display: table-header-group;\n    }\n\n    .hse-form-format table.ir-actions thead th {\n        border-top: none;\n        font-size: 9px;\n    }\n\n    .hse-form-format table.ir-actions td {\n        font-size: 10.5px;\n    }\n\n    .hse-form-format .ca-title {\n        font-weight: bold;\n    }\n\n    .hse-form-format .ca-meta {\n        font-size: 9.5px;\n        color: #444;\n    }\n\n    .hse-form-format .ca-text {\n        margin-top: 3px;\n    }\n\n    .hse-form-format .ca-overdue {\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .hse-form-format table.ir-whys {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .hse-form-format table.ir-whys td {\n        border: 1px solid #000;\n        padding: 4px 6px;\n        vertical-align: top;\n        font-size: 11px;\n    }\n\n    .hse-form-format table.ir-whys td.why-n {\n        width: 13%;\n        background: #f0f0f0;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        white-space: nowrap;\n    }\n\n    .hse-form-format table.ir-sig-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 18px 0 10px 0;\n        page-break-inside: avoid;\n    }\n\n    .hse-form-format table.ir-sig-table td {\n        border: none;\n        padding: 0;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-val {\n        border-bottom: 1px solid #000;\n        vertical-align: bottom;\n        padding: 16px 4px 2px 4px;\n        font-size: 11px;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-img {\n        padding: 2px 4px 2px 4px;\n        height: 48px;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-gap {\n        width: 4%;\n    }\n\n    .hse-form-format table.ir-sig-table td.sig-label {\n        padding-top: 3px;\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-align: left;\n    }\n\n    .hse-form-format .ir-post {\n        border: 2px solid #000;\n        text-align: center;\n        font-weight: bold;\n        font-size: 10px;\n        text-transform: uppercase;\n        padding: 4px;\n        margin-bottom: 8px;\n    }\n\n    .hse-form-format .cb {\n        display: inline-block;\n        width: 10px;\n        height: 10px;\n        line-height: 10px;\n        border: 1px solid #000;\n        text-align: center;\n        font-size: 9px;\n        font-weight: bold;\n        margin-right: 4px;\n        vertical-align: middle;\n    }\n\n    .hse-form-format table.ir-checks {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    .hse-form-format table.ir-checks td {\n        border: none;\n        padding: 2px 4px;\n        font-size: 10.5px;\n        vertical-align: top;\n    }\n\n    .hse-form-format table.ir-table.ir-grid td,\n    .hse-form-format table.ir-table.ir-grid th {\n        font-size: 10px;\n        padding: 4px 4px;\n    }\n\n    .hse-form-format table.ir-grid thead {\n        display: table-header-group;\n    }\n\n    .hse-form-format table.ir-grid tr {\n        page-break-inside: avoid;\n    }\n\n    .hse-form-format .ir-rate {\n        display: inline-block;\n        padding: 1px 4px;\n        font-weight: bold;\n        font-size: 9.5px;\n        border: 1px solid #000;\n    }\n\n    .hse-form-format table.ir-matrix {\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .hse-form-format table.ir-matrix td,\n    .hse-form-format table.ir-matrix th {\n        border: 1px solid #000;\n        padding: 2px 6px;\n        font-size: 9px;\n        text-align: center;\n    }\n\n    .hse-form-format .ir-small {\n        font-size: 9px;\n        color: #333;\n    }\n</style>\n\n{% macro fdate(value) -%}{{ frappe.utils.formatdate(value) if value else \"\" }}{%- endmacro %}\n{% macro fdt(value) -%}{{ frappe.utils.format_datetime(value) if value else \"\" }}{%- endmacro %}\n{% macro txt(value) -%}{{ (value or \"\") | e }}{%- endmacro %}\n{% macro cb(value, label) -%}<span class=\"cb\">{{ \"X\" if value else \"\" }}</span>{{ label }}{%- endmacro %}\n{% set RATE_BG = {\"Low\": \"#d9f2d9\", \"Medium\": \"#fff3c4\", \"High\": \"#ffd8b0\", \"Critical\": \"#f8c4c4\"} %}\n{% macro rate(score, rating) -%}{% if rating %}<span class=\"ir-rate\" style=\"background:{{ RATE_BG.get(rating, '#fff') }}\">{{ score }} {{ rating }}</span>{% endif %}{%- endmacro %}\n{% macro level(value) -%}{{ (value or \"\").split(\" \")[0] }}{%- endmacro %}\n{% macro sig(labels) -%}\n<table class=\"ir-sig-table\"><tr>\n{% for l in labels %}{% if not loop.first %}<td class=\"sig-gap\"></td>{% endif %}<td class=\"sig-val\">{{ l[1] or \"\" }}</td>{% endfor %}\n</tr><tr>\n{% for l in labels %}{% if not loop.first %}<td class=\"sig-gap\"></td>{% endif %}<td class=\"sig-label\">{{ l[0] }}</td>{% endfor %}\n</tr></table>\n{%- endmacro %}\n{% macro matrix() -%}\n<table class=\"ir-matrix\">\n<tr><th>L \\ S</th>{% for s in range(1, 6) %}<th>{{ s }}</th>{% endfor %}</tr>\n{% for l in range(5, 0, -1) %}<tr><th>{{ l }}</th>{% for s in range(1, 6) %}{% set r = s * l %}{% set band = \"Critical\" if r >= 20 else (\"High\" if r >= 10 else (\"Medium\" if r >= 5 else \"Low\")) %}<td style=\"background:{{ RATE_BG[band] }}\">{{ r }}</td>{% endfor %}</tr>{% endfor %}\n</table>\n<div class=\"ir-small\">Severity 1 Negligible, 2 Minor, 3 Moderate, 4 Major, 5 Catastrophic. Likelihood 1 Rare, 2 Unlikely, 3 Possible, 4 Likely, 5 Almost Certain.\nRisk = S &times; L: Low 1&ndash;4, Medium 5&ndash;9, High 10&ndash;16, Critical 20&ndash;25 (work must not proceed).</div>\n{%- endmacro %}\n\n<div class=\"hse-form-format\">\n<table class=\"psif-hdr\" style=\"width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 6px 0; border:none\">\n\t<tr>\n\t\t<td style=\"width:28%; font-size:9px; text-align:left; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">355 Gus Hipp Blvd.<br>Rockledge, FL 32955</td>\n\t\t<td style=\"width:44%; text-align:center; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\"><img src=\"{{ frappe.utils.get_url('/assets/hse/images/psif_logo.jpg') }}\" alt=\"Power Systems, Inc. of Florida\" style=\"height:52px\"></td>\n\t\t<td style=\"width:28%; font-size:9px; text-align:right; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">Tel: (321) 636-0085<br><b>www.psifla.com</b></td>\n\t</tr>\n</table>\n\n    <div class=\"ir-header\">\n        <div class=\"ir-title\">Confined Space Entry Permit</div>\n        <div class=\"ir-doc-line\">Permit No. {{ doc.name }} &nbsp;|&nbsp; {{ doc.status }} &nbsp;|&nbsp; 29 CFR 1910.146</div>\n    </div>\n    <div class=\"ir-post\">Post this permit at the entry point for the duration of the entry</div>\n\n    <table class=\"ir-table\">\n        <tr>\n            <th colspan=\"2\">Permit Space</th>\n            <th>Location</th>\n            <th>Equipment</th>\n        </tr>\n        <tr>\n            <td colspan=\"2\"><b>{{ txt(doc.space_name) }}</b></td>\n            <td>{{ doc.location or \"\" }}</td>\n            <td>{{ doc.asset or \"\" }}</td>\n        </tr>\n        <tr>\n            <th style=\"width:25%\">Entry Authorized From</th>\n            <th style=\"width:25%\">Authorized Until</th>\n            <th style=\"width:25%\">Entry Supervisor</th>\n            <th style=\"width:25%\">Job Hazard Analysis</th>\n        </tr>\n        <tr>\n            <td>{{ fdt(doc.permit_start) }}</td>\n            <td>{{ fdt(doc.permit_end) }}</td>\n            <td>{{ doc.entry_supervisor_name or doc.entry_supervisor or \"\" }}</td>\n            <td>{{ doc.job_hazard_analysis or \"\" }}</td>\n        </tr>\n        <tr><th colspan=\"4\">Purpose of Entry</th></tr>\n        <tr><td colspan=\"4\" class=\"ir-text\">{{ txt(doc.purpose) }}</td></tr>\n    </table>\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Hazards of the Permit Space</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        <table class=\"ir-checks\">\n            <tr>\n                <td>{{ cb(doc.hz_oxygen, \"Oxygen deficiency / enrichment\") }}</td>\n                <td>{{ cb(doc.hz_flammable, \"Flammable atmosphere\") }}</td>\n                <td>{{ cb(doc.hz_toxic, \"Toxic atmosphere\") }}</td>\n                <td>{{ cb(doc.hz_engulfment, \"Engulfment\") }}</td>\n            </tr>\n            <tr>\n                <td>{{ cb(doc.hz_entrapment, \"Entrapment / converging walls\") }}</td>\n                <td>{{ cb(doc.hz_mechanical, \"Mechanical / moving parts\") }}</td>\n                <td>{{ cb(doc.hz_electrical, \"Electrical\") }}</td>\n                <td>{{ cb(doc.hz_pressure, \"Hydraulic / stored pressure\") }}</td>\n            </tr>\n            <tr>\n                <td>{{ cb(doc.hz_thermal, \"Heat / cold\") }}</td>\n                <td>{{ cb(doc.hz_noise, \"Noise\") }}</td>\n                <td colspan=\"2\">Other: {{ txt(doc.hz_other) }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"ir-section-label\">Isolation and Hazard Control</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        <table class=\"ir-checks\">\n            <tr>\n                <td>{{ cb(doc.iso_lockout, \"Lockout / tagout applied\") }}</td>\n                <td>{{ cb(doc.iso_blanked, \"Lines blanked / blinded / disconnected\") }}</td>\n                <td>{{ cb(doc.iso_purged, \"Purged / flushed / cleaned\") }}</td>\n            </tr>\n            <tr>\n                <td>{{ cb(doc.iso_inerted, \"Inerted\") }}</td>\n                <td>{{ cb(doc.iso_ventilated, \"Forced-air ventilation\") }}{% if doc.ventilation_detail %}: {{ txt(doc.ventilation_detail) }}{% endif %}</td>\n                <td>{{ cb(doc.iso_barricade, \"Entry area barricaded / openings guarded\") }}</td>\n            </tr>\n            {% if doc.iso_other %}<tr><td colspan=\"3\">Other: {{ txt(doc.iso_other) }}</td></tr>{% endif %}\n        </table>\n    </div>\n    </div>\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Acceptable Entry Conditions and Atmospheric Tests</div>\n    <table class=\"ir-table ir-grid\" style=\"border-top:none; margin-bottom:0\">\n        <tr>\n            <th style=\"width:25%\">Oxygen</th>\n            <th style=\"width:25%\">Flammable (LEL)</th>\n            <th style=\"width:25%\">Hydrogen Sulfide</th>\n            <th style=\"width:25%\">Carbon Monoxide</th>\n        </tr>\n        <tr>\n            <td>{{ doc.oxygen_min }} &ndash; {{ doc.oxygen_max }} %</td>\n            <td>&le; {{ doc.lel_max }} %</td>\n            <td>&le; {{ doc.h2s_max }} ppm</td>\n            <td>&le; {{ doc.co_max }} ppm</td>\n        </tr>\n        <tr><td colspan=\"4\" class=\"ir-small\">Periodic testing: {{ txt(doc.test_frequency) }}. Test oxygen first, then flammable gases, then toxic gases.</td></tr>\n    </table>\n    <table class=\"ir-table ir-grid\" style=\"border-top:none\">\n        <thead>\n            <tr>\n                <th style=\"width:17%\">Time</th>\n                <th style=\"width:11%\">Test</th>\n                <th style=\"width:9%\">O&#8322; %</th>\n                <th style=\"width:9%\">LEL %</th>\n                <th style=\"width:10%\">H&#8322;S ppm</th>\n                <th style=\"width:9%\">CO ppm</th>\n                <th style=\"width:12%\">Monitor</th>\n                <th style=\"width:12%\">Tested By</th>\n                <th style=\"width:11%\">Result</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for t in doc.atmospheric_tests %}\n            <tr>\n                <td>{{ fdt(t.test_time) }}</td>\n                <td>{{ t.test_type or \"\" }}</td>\n                <td>{{ t.oxygen_pct if t.oxygen_pct is not none else \"\" }}</td>\n                <td>{{ t.lel_pct if t.lel_pct is not none else \"\" }}</td>\n                <td>{{ t.h2s_ppm if t.h2s_ppm is not none else \"\" }}</td>\n                <td>{{ t.co_ppm if t.co_ppm is not none else \"\" }}</td>\n                <td>{{ t.instrument or \"\" }}</td>\n                <td>{{ t.tested_by or \"\" }}</td>\n                <td><b>{{ t.result or \"\" }}</b></td>\n            </tr>\n        {% endfor %}\n        {% for i in range(doc.atmospheric_tests | length, 8) %}\n            <tr><td style=\"height:18px\"></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        {% endfor %}\n        </tbody>\n    </table>\n    </div>\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Authorized Entrants, Attendants and Entry Supervisor</div>\n    <table class=\"ir-table ir-grid\" style=\"border-top:none\">\n        <thead>\n            <tr>\n                <th style=\"width:15%\">Role</th>\n                <th style=\"width:24%\">Name</th>\n                <th style=\"width:17%\">Company</th>\n                <th style=\"width:16%\">Time In</th>\n                <th style=\"width:16%\">Time Out</th>\n                <th style=\"width:12%\">Initials</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for w in doc.workers %}\n            <tr>\n                <td>{{ w.role or \"\" }}</td>\n                <td>{{ w.worker_name or \"\" }}</td>\n                <td>{{ w.employer or \"\" }}</td>\n                <td>{{ fdt(w.time_in) }}</td>\n                <td>{{ fdt(w.time_out) }}</td>\n                <td></td>\n            </tr>\n        {% endfor %}\n        {% for i in range(doc.workers | length, 6) %}\n            <tr><td style=\"height:18px\"></td><td></td><td></td><td></td><td></td><td></td></tr>\n        {% endfor %}\n        </tbody>\n    </table>\n    </div>\n\n    <div class=\"ir-keep\">\n    <table class=\"ir-table\">\n        <tr>\n            <th style=\"width:50%\">Rescue</th>\n            <th style=\"width:50%\">Communication (Entrant &ndash; Attendant)</th>\n        </tr>\n        <tr>\n            <td>\n                <b>{{ doc.rescue_service or \"\" }}</b>{% if doc.rescue_contact %} &mdash; {{ txt(doc.rescue_contact) }}{% endif %}\n                <div class=\"ir-sub\">How to Summon Rescue</div>\n                <div class=\"ir-text\">{{ txt(doc.summon_rescue) }}</div>\n            </td>\n            <td>\n                <b>{{ doc.communication_method or \"\" }}</b>\n                <div class=\"ir-text\">{{ txt(doc.communication_detail) }}</div>\n            </td>\n        </tr>\n    </table>\n\n    <div class=\"ir-section-label\">Equipment</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        <table class=\"ir-checks\">\n            <tr>\n                <td>{{ cb(doc.eq_gas_monitor, \"Calibrated gas monitor\") }}</td>\n                <td>{{ cb(doc.eq_blower, \"Ventilation blower\") }}</td>\n                <td>{{ cb(doc.eq_harness, \"Full-body harness / wristlets\") }}</td>\n                <td>{{ cb(doc.eq_retrieval, \"Retrieval line / tripod / winch\") }}</td>\n            </tr>\n            <tr>\n                <td>{{ cb(doc.eq_radio, \"Radios / communication\") }}</td>\n                <td>{{ cb(doc.eq_lighting, \"Approved lighting\") }}</td>\n                <td>{{ cb(doc.eq_ladder, \"Ladder / safe access\") }}</td>\n                <td>{{ cb(doc.eq_alarm, \"Evacuation alarm\") }}</td>\n            </tr>\n        </table>\n        {% if doc.eq_ppe %}<div class=\"ir-sub\">PPE Required</div><div class=\"ir-text\">{{ txt(doc.eq_ppe) }}</div>{% endif %}\n        {% if doc.eq_other %}<div class=\"ir-sub\">Other Equipment</div><div class=\"ir-text\">{{ txt(doc.eq_other) }}</div>{% endif %}\n    </div>\n\n    <div class=\"ir-section-label\">Other Permits and Information</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        {{ cb(doc.hot_work_permit, \"Hot work permit required\") }}{% if doc.hot_work_permit_no %} &mdash; No. {{ txt(doc.hot_work_permit_no) }}{% endif %}\n        {% if doc.other_permit_notes %}<div class=\"ir-text\" style=\"margin-top:4px\">{{ txt(doc.other_permit_notes) }}</div>{% endif %}\n    </div>\n    </div>\n\n    <div class=\"ir-keep\">\n    <div class=\"ir-section-label\">Entry Supervisor Authorization</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        I have verified that the hazards are controlled, the acceptable entry conditions are met, rescue is available and the\n        required equipment is in place. Entry is authorized for the period above.\n        {{ sig([[\"Entry Supervisor\", doc.entry_supervisor_name], [\"Issued\", fdt(doc.issued_on)]]) }}\n    </div>\n\n    <div class=\"ir-section-label\">Permit Closure</div>\n    <div class=\"ir-section-body\" style=\"min-height:0\">\n        {{ cb(doc.closure_reason == \"Work Completed\", \"Work completed\") }} &nbsp;\n        {{ cb(doc.closure_reason == \"Prohibited Condition\", \"Prohibited condition\") }} &nbsp;\n        {{ cb(doc.closure_reason == \"Permit Expired\", \"Authorized period ended\") }}\n        {% if doc.closure_notes %}<div class=\"ir-text\" style=\"margin-top:4px\">{{ txt(doc.closure_notes) }}</div>{% endif %}\n        {{ sig([[\"Closed By (Entry Supervisor)\", doc.closed_by], [\"Date / Time\", fdt(doc.closed_on)]]) }}\n        <div class=\"ir-small\">Keep closed permits for at least one year (29 CFR 1910.146(e)(6)). Note any problems found during the entry for the annual program review.</div>\n    </div>\n    </div>\n\n</div>\n",
