 "html": "<style>\n    .incident-report-format {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 11px;\n        color: #000;\n        width: 100%;\n    }\n\n    .incident-report-format .ir-header {\n        border-bottom: 2px solid #000;\n        padding-bottom: 6px;\n        margin-bottom: 8px;\n    }\n\n    .incident-report-format .ir-title {\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .incident-report-format .ir-doc-line {\n        font-size: 10.5px;\n        margin-top: 2px;\n    }\n\n    .incident-report-format table.ir-table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n        margin-bottom: 8px;\n    }\n\n    .incident-report-format table.ir-table td,\n    .incident-report-format table.ir-table th {\n        border: 1px solid #000;\n        padding: 5px 6px;\n        vertical-align: top;\n        font-size: 11px;\n        height: 14px;\n    }\n\n    .incident-report-format table.ir-table th {\n        background: #d9d9d9;\n        text-transform: uppercase;\n        font-size: 9.5px;\n        font-weight: bold;\n        text-align: left;\n    }\n\n    .incident-report-format .ir-section-label {\n        background: #d9d9d9;\n        border: 1px solid #000;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        padding: 5px 6px;\n    }\n\n    .incident-report-format .ir-section-body {\n        border: 1px solid #000;\n        border-top: none;\n        padding: 8px 6px;\n        min-height: 40px;\n        margin-bottom: 8px;\n        font-size: 11px;\n    }\n\n    .incident-report-format .ir-section-body.tall {\n        min-height: 70px;\n    }\n\n    .incident-report-format .ir-sub {\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        margin: 8px 0 2px 0;\n    }\n\n    .incident-report-format .ir-sub:first-child {\n        margin-top: 0;\n    }\n\n    .incident-report-format .ir-text {\n        white-space: pre-wrap;\n    }\n\n    .incident-report-format .ir-rich p {\n        margin: 0 0 4px 0;\n    }\n\n    .incident-report-format .ir-empty {\n        color: #555;\n    }\n\n    .incident-report-format ol.ir-causes {\n        margin: 0;\n        padding-left: 18px;\n    }\n\n    .incident-report-format table.ir-whys {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 2px 0 8px 0;\n    }\n\n    .incident-report-format table.ir-whys td {\n        border: 1px solid #000;\n        padding: 4px 6px;\n        vertical-align: top;\n        font-size: 11px;\n    }\n\n    .incident-report-format table.ir-whys td.why-n {\n        width: 13%;\n        background: #f0f0f0;\n        font-weight: bold;\n        font-size: 9.5px;\n        text-transform: uppercase;\n        white-space: nowrap;\n    }\n\n    .incident-report-format table.ir-sig-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 18px 0 10px 0;\n    }\n\n    .incident-report-format table.ir-sig-table td {\n        border: none;\n        padding: 0;\n    }\n\n    .incident-report-format table.ir-sig-table td.sig-val {\n        border-bottom: 1px solid #000;\n        vertical-align: bottom;\n        padding: 16px 4px 2px 4px;\n        font-size: 11px;\n    }\n\n    .incident-report-format table.ir-sig-table td.sig-gap {\n        width: 4%;\n    }\n\n    .incident-report-format table.ir-sig-table td.sig-label {\n        padding-top: 3px;\n        font-size: 9px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-align: left;\n    }\n</style>\n\n{% set employee_full_name = ((frappe.db.get_value(\"Employee\", doc.employee_name, \"employee_name\") if doc.employee_name else \"\") or doc.employee_name or \"\") %}\n{% set completed_by_name = ((frappe.db.get_value(\"Employee\", doc.completed_by, \"employee_name\") if doc.completed_by else \"\") or doc.completed_by or \"\") %}\n{% set manager_full_name = ((frappe.db.get_value(\"Employee\", doc.managers_name, \"employee_name\") if doc.managers_name else \"\") or doc.managers_name or \"\") %}\n{% set assigned_name = ((frappe.db.get_value(\"User\", doc.assigned_to, \"full_name\") if doc.assigned_to else \"\") or doc.assigned_to or \"\") %}\n{% set non_employee = ((doc.non_employee_name or \"\") | trim) %}\n{% set persons_involved = ([employee_full_name, non_employee] | select | join(\", \")) %}\n{% set root_causes = ([doc.root_cause_1, doc.root_cause_2, doc.root_cause_3] | select | list) %}\n{% set whys = [doc.why_1, doc.why_2, doc.why_3, doc.why_4, doc.why_5] %}\n{% set has_whys = (whys | select | list | length) > 0 %}\n{% macro has_rich(value) -%}{{ \"1\" if value and (frappe.utils.strip_html(value) | replace(\"&nbsp;\", \" \") | trim) else \"\" }}{%- endmacro %}\n{% macro fdate(value) -%}{{ frappe.utils.formatdate(value) if value else \"\" }}{%- endmacro %}\n\n<div class=\"incident-report-format\">\n<table class=\"psif-hdr\" style=\"width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 6px 0; border:none\">\n\t<tr>\n\t\t<td style=\"width:28%; font-size:9px; text-align:left; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">355 Gus Hipp Blvd.<br>Rockledge, FL 32955</td>\n\t\t<td style=\"width:44%; text-align:center; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\"><img src=\"{{ frappe.utils.get_url('/assets/hse/images/psif_logo.jpg') }}\" alt=\"Power Systems, Inc. of Florida\" style=\"height:52px\"></td>\n\t\t<td style=\"width:28%; font-size:9px; text-align:right; border:none !important; padding:3px 6px !important; vertical-align:middle; background:none !important\">Tel: (321) 636-0085<br><b>www.psifla.com</b></td>\n\t</tr>\n</table>\n\n    <div class=\"ir-header\">\n        <div class=\"ir-title\">Workplace Incident Report</div>\n        <div class=\"ir-doc-line\">Case No. {{ doc.name }}{% if doc.type_of_incident %} &nbsp;|&nbsp; {{ doc.type_of_incident }}{% endif %}</div>\n    </div>\n\n    <table class=\"ir-table\">\n        <tr>\n            <th style=\"width:25%\">Date of Incident</th>\n            <th style=\"width:25%\">Location</th>\n            <th style=\"width:25%\">Department</th>\n            <th style=\"width:25%\">Risk Level</th>\n        </tr>\n        <tr>\n            <td>{{ fdate(doc.incident_date) }}</td>\n            <td>{{ doc.incident_location or \"\" }}</td>\n            <td>{{ doc.employee_department or \"\" }}</td>\n            <td>{{ doc.risk_level or \"\" }}</td>\n        </tr>\n        <tr>\n            <th colspan=\"2\">Person(s) Involved</th>\n            <th>Manager</th>\n            <th>Cost</th>\n        </tr>\n        <tr>\n            <td colspan=\"2\">{{ persons_involved }}</td>\n            <td>{{ manager_full_name }}</td>\n            <td>{{ doc.cost or \"\" }}</td>\n        </tr>\n        {% if doc.witnesses %}\n        <tr><th colspan=\"4\">Witnesses</th></tr>\n        <tr><td colspan=\"4\" class=\"ir-text\">{{ doc.witnesses | e }}</td></tr>\n        {% endif %}\n    </table>\n\n    <!-- ===================== INCIDENT DETAILS ===================== -->\n    <div class=\"ir-section-label\">Incident Details</div>\n    <div class=\"ir-section-body tall\">\n        {% set shown = namespace(any=false) %}\n        {% if doc.short_description %}{% set shown.any = true %}\n        <div class=\"ir-sub\">Summary</div>\n        <div class=\"ir-text\">{{ doc.short_description | e }}</div>\n        {% endif %}\n        {% if has_rich(doc.before_incident) %}{% set shown.any = true %}\n        <div class=\"ir-sub\">What was being done before the incident</div>\n        <div class=\"ir-rich\">{{ doc.before_incident }}</div>\n        {% endif %}\n        {% if has_rich(doc.what_happened) %}{% set shown.any = true %}\n        <div class=\"ir-sub\">What happened</div>\n        <div class=\"ir-rich\">{{ doc.what_happened }}</div>\n        {% endif %}\n        {% if doc.object_harm %}{% set shown.any = true %}\n        <div class=\"ir-sub\">Object / property involved</div>\n        <div class=\"ir-text\">{{ doc.object_harm | e }}</div>\n        {% endif %}\n        {% if doc.unsafe_act_description %}{% set shown.any = true %}\n        <div class=\"ir-sub\">Unsafe act or condition</div>\n        <div class=\"ir-text\">{{ doc.unsafe_act_description | e }}</div>\n        {% endif %}\n        {% if not shown.any %}<span class=\"ir-empty\">No incident details recorded.</span>{% endif %}\n    </div>\n\n    <!-- ===================== ROOT CAUSE ===================== -->\n    <div class=\"ir-section-label\">Root Cause</div>\n    <div class=\"ir-section-body\">\n        {% if has_whys or doc.five_whys_problem %}\n        <div class=\"ir-sub\">5 Whys</div>\n        <table class=\"ir-whys\">\n            <tr><td class=\"why-n\">Problem</td><td class=\"ir-text\">{{ (doc.five_whys_problem or \"\") | e }}</td></tr>\n            {% for why in whys %}{% if why %}\n            <tr><td class=\"why-n\">Why {{ loop.index }}</td><td class=\"ir-text\">{{ why | e }}</td></tr>\n            {% endif %}{% endfor %}\n        </table>\n        {% endif %}\n        {% if root_causes %}\n        {% if has_whys or doc.five_whys_problem %}<div class=\"ir-sub\">Root cause(s)</div>{% endif %}\n        <ol class=\"ir-causes\">\n            {% for cause in root_causes %}<li>{{ cause | e }}</li>{% endfor %}\n        </ol>\n        {% endif %}\n        {% if has_rich(doc.investigation_notes) %}\n        <div class=\"ir-sub\"{% if root_causes %} style=\"margin-top:8px\"{% endif %}>Investigation notes</div>\n        <div class=\"ir-rich\">{{ doc.investigation_notes }}</div>\n        {% endif %}\n        {% if not root_causes and not has_whys and not doc.five_whys_problem and not has_rich(doc.investigation_notes) %}<span class=\"ir-empty\">Root cause not yet determined.</span>{% endif %}\n    </div>\n\n    <!-- ===================== CORRECTIVE ACTION ===================== -->\n    <div class=\"ir-section-label\">Corrective Action</div>\n    {% set has_action = doc.title or doc.task_description or has_rich(doc.task_notes) or doc.responsible_party or doc.assigned_to or doc.date_due %}\n    {% if has_action %}\n    <table class=\"ir-table\" style=\"margin-bottom:0\">\n        <tr>\n            <th style=\"width:40%\">Action</th>\n            <th style=\"width:20%\">Type</th>\n            <th style=\"width:20%\">Priority</th>\n            <th style=\"width:20%\">Responsible</th>\n        </tr>\n        <tr>\n            <td style=\"border-top:none\">{{ doc.title or \"\" }}</td>\n            <td style=\"border-top:none\">{{ doc.action_type or \"\" }}</td>\n            <td style=\"border-top:none\">{{ doc.priority or \"\" }}</td>\n            <td style=\"border-top:none\">{{ doc.responsible_party or assigned_name }}</td>\n        </tr>\n        <tr>\n            <th>Due Date</th>\n            <th>Started</th>\n            <th>Completed</th>\n            <th>Verified</th>\n        </tr>\n        <tr>\n            <td>{{ fdate(doc.date_due) }}</td>\n            <td>{{ fdate(doc.date_start) }}</td>\n            <td>{{ fdate(doc.date_done) }}</td>\n            <td>{{ fdate(doc.date_verify) }}</td>\n        </tr>\n    </table>\n    <div class=\"ir-section-body\">\n        {% if doc.task_description %}\n        <div class=\"ir-sub\">Description</div>\n        <div class=\"ir-text\">{{ doc.task_description | e }}</div>\n        {% endif %}\n        {% if has_rich(doc.task_notes) %}\n        <div class=\"ir-sub\">Notes</div>\n        <div class=\"ir-rich\">{{ doc.task_notes }}</div>\n        {% endif %}\n        {% if not doc.task_description and not has_rich(doc.task_notes) %}<span class=\"ir-empty\">No description recorded.</span>{% endif %}\n    </div>\n    {% else %}\n    <div class=\"ir-section-body\"><span class=\"ir-empty\">No corrective action recorded.</span></div>\n    {% endif %}\n\n    <table class=\"ir-sig-table\">\n        <tr>\n            <td class=\"sig-val\" style=\"width:34%\">{{ completed_by_name }}{% if doc.completed_title %}, {{ doc.completed_title }}{% endif %}</td>\n            <td class=\"sig-gap\"></td>\n            <td class=\"sig-val\" style=\"width:38%\"></td>\n            <td class=\"sig-gap\"></td>\n            <td class=\"sig-val\" style=\"width:20%\">{{ fdate(doc.completed_by_date) }}</td>\n        </tr>\n        <tr>\n            <td class=\"sig-label\">Completed By</td>\n            <td></td>\n            <td class=\"sig-label\">Signature</td>\n            <td></td>\n            <td class=\"sig-label\">Date</td>\n        </tr>\n    </table>\n</div>\n",
 "line_breaks": 0,
